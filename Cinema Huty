<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cinema Huty</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: #0b0e17;
      color: #f3f4f6;
      padding-bottom: 48px;
    }

    .topbar {
      background: #121726;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #1f273d;
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .menu-btn {
      font-size: 1.3rem;
      color: #e5e7eb;
      background: none;
      border: none;
    }

    .brand {
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: #ffffff;
      text-shadow: 0 0 12px rgba(255, 71, 87, 0.55);
    }

    .search-wrap {
      padding: 14px 18px 6px;
    }

    .search-box {
      width: 100%;
      background: #151b2e;
      border: 1px solid #26314d;
      border-radius: 10px;
      padding: 12px 14px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
    }

    .section {
      padding: 18px 0 6px 18px;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
      padding-right: 18px;
    }

    .section-title {
      font-size: 1.08rem;
      font-weight: 700;
      color: #ffffff;
    }

    .row-scroll {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding-right: 18px;
      scrollbar-width: none;
    }

    .row-scroll::-webkit-scrollbar {
      display: none;
    }

    .movie-card {
      min-width: 155px;
      max-width: 155px;
      background: #131828;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #202942;
      flex-shrink: 0;
    }

    .poster {
      position: relative;
      height: 215px;
      background: linear-gradient(135deg, #242b45, #141826);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 10px;
      color: #ff6b81;
      font-weight: 700;
      background-size: cover;
      background-position: center;
    }

    .rank-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      background: #f5b700;
      color: #111;
      font-weight: 800;
      font-size: 0.78rem;
      padding: 3px 7px;
      border-radius: 5px;
    }

    .progress-badge {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(15, 23, 42, 0.88);
      color: #fff;
      font-weight: 700;
      font-size: 0.75rem;
      padding: 3px 7px;
      border-radius: 5px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .movie-info {
      padding: 10px;
    }

    .movie-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: #f9fafb;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 4px;
    }

    .movie-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      color: #9ca3af;
    }
  </style>
</head>
<body>
  <header class="topbar">
    <button class="menu-btn" aria-label="Menu">☰</button>
    <div class="brand">CINEMA HUTY</div>
    <span style="width: 20px;"></span>
  </header>

  <div class="search-wrap">
    <input
      type="text"
      id="searchInput"
      class="search-box"
      placeholder="Search movie / series..."
    />
  </div>

  <section class="section">
    <div class="section-header">
      <span>🔥</span>
      <h2 class="section-title">Weekly Top 20 Trending</h2>
    </div>
    <div class="row-scroll" id="trendingList">
      <div class="movie-card" data-title="Operation Shadow">
        <div class="poster">
          <span class="rank-badge">#1</span>
          <span>POSTER 01</span>
        </div>
        <div class="movie-info">
          <div class="movie-title">Operation Shadow</div>
          <div class="movie-meta">
            <span>2026</span>
            <span>1,431 Hits</span>
          </div>
        </div>
      </div>

      <div class="movie-card" data-title="Midnight Echo">
        <div class="poster">
          <span class="rank-badge">#2</span>
          <span>POSTER 02</span>
        </div>
        <div class="movie-info">
          <div class="movie-title">Midnight Echo</div>
          <div class="movie-meta">
            <span>2025</span>
            <span>980 Hits</span>
          </div>
        </div>
      </div>

      <div class="movie-card" data-title="Lost Horizon">
        <div class="poster">
          <span class="rank-badge">#3</span>
          <span>POSTER 03</span>
        </div>
        <div class="movie-info">
          <div class="movie-title">Lost Horizon</div>
          <div class="movie-meta">
            <span>2026</span>
            <span>765 Hits</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <span>▶</span>
      <h2 class="section-title">Continue Watching</h2>
    </div>
    <div class="row-scroll" id="continueList">
      <div class="movie-card" data-title="The Last Signal">
        <div class="poster">
          <span class="progress-badge">58%</span>
          <span>WATCHING 01</span>
        </div>
        <div class="movie-info">
          <div class="movie-title">The Last Signal</div>
          <div class="movie-meta">
            <span>Episode 04</span>
            <span>HD</span>
          </div>
        </div>
      </div>

      <div class="movie-card" data-title="City of Dust">
        <div class="poster">
          <span class="progress-badge">32%</span>
          <span>WATCHING 02</span>
        </div>
        <div class="movie-info">
          <div class="movie-title">City of Dust</div>
          <div class="movie-meta">
            <span>Movie</span>
            <span>1080p</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById("searchInput");
    const cards = document.querySelectorAll(".movie-card");

    searchInput.addEventListener("input", () => {
      const q = searchInput.value.toLowerCase().trim();
      cards.forEach((card) => {
        const title = card.getAttribute("data-title").toLowerCase();
        card.style.display = title.includes(q) ? "block" : "none";
      });
    });
  </script>
</body>
</html>
