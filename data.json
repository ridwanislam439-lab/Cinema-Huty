<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel - CINEMA HUTY</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: #f8fafc;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 16px;
    }
    .card {
      background: #1e293b;
      padding: 24px;
      border-radius: 10px;
      width: 100%;
      max-width: 420px;
    }
    input, select, textarea, button {
      width: 100%;
      padding: 10px;
      margin-top: 10px;
      border-radius: 6px;
      border: none;
      box-sizing: border-box;
      font-size: 14px;
    }
    button {
      background: #eab308;
      color: #0f172a;
      font-weight: bold;
      cursor: pointer;
    }
    button.secondary {
      background: #334155;
      color: #f8fafc;
    }
    #panel { display: none; }
    #error { color: #f87171; margin-top: 10px; font-size: 14px; }
    textarea {
      height: 140px;
      background: #0f172a;
      color: #38bdf8;
      font-family: monospace;
    }
  </style>
</head>
<body>
  <div class="card">
    <!-- Login Section -->
    <div id="loginBox">
      <h2>Admin Login</h2>
      <input type="password" id="passInput" placeholder="Enter admin passcode" />
      <button id="loginBtn" type="button">Login</button>
      <div id="error"></div>
    </div>

    <!-- Admin Dashboard Section -->
    <div id="panel">
      <h2>Add Movie / Series</h2>
      <input type="text" id="title" placeholder="Title (e.g. Inception)" />
      <select id="category">
        <option value="MOVIE">MOVIE</option>
        <option value="TV SERIES">TV SERIES</option>
        <option value="LIVE TV">LIVE TV</option>
      </select>
      <input type="text" id="poster" placeholder="Poster Image URL" />
      <input type="text" id="streamUrl" placeholder="Stream / Embed URL" />
      <button id="addBtn" type="button">Generate Updated JSON</button>

      <textarea id="jsonOutput" readonly placeholder="Updated data.json will appear here..."></textarea>
      <button id="copyBtn" class="secondary" type="button">Copy JSON</button>
      <p style="font-size: 12px; color: #94a3b8;">
        Copy kore GitHub-er <b>data.json</b> file-e paste kore Commit korun.
      </p>
      <a href="index.html" style="color: #eab308; font-size: 14px;">← Back to Home</a>
    </div>
  </div>

  <script>
    const PASSCODE = "change-this-passcode";
    let catalog = [];

    const loginBtn = document.getElementById("loginBtn");
    const passInput = document.getElementById("passInput");
    const errorEl = document.getElementById("error");
    const loginBox = document.getElementById("loginBox");
    const panel = document.getElementById("panel");
    const jsonOutput = document.getElementById("jsonOutput");

    // Existing data.json load kora
    async function loadExistingData() {
      try {
        const res = await fetch("data.json");
        if (res.ok) {
          catalog = await res.json();
          jsonOutput.value = JSON.stringify(catalog, null, 2);
        }
      } catch (e) {
        console.log("No existing data.json found yet.");
      }
    }

    loginBtn.addEventListener("click", () => {
      if (passInput.value === PASSCODE) {
        errorEl.textContent = "";
        loginBox.style.display = "none";
        panel.style.display = "block";
        loadExistingData();
      } else {
        errorEl.textContent = "Invalid passcode.";
      }
    });

    document.getElementById("addBtn").addEventListener("click", () => {
      const title = document.getElementById("title").value.trim();
      const category = document.getElementById("category").value;
      const poster = document.getElementById("poster").value.trim();
      const streamUrl = document.getElementById("streamUrl").value.trim();

      if (!title || !streamUrl) {
        alert("Title ar Stream URL dite hobe!");
        return;
      }

      const newItem = {
        id: "item-" + Date.now(),
        title: title,
        type: category.toLowerCase().replace(" ", "-"),
        category: category,
        poster: poster || "https://via.placeholder.com/300x450?text=No+Poster",
        streamUrl: streamUrl
      };

      catalog.push(newItem);
      jsonOutput.value = JSON.stringify(catalog, null, 2);

      // Input clear kora
      document.getElementById("title").value = "";
      document.getElementById("poster").value = "";
      document.getElementById("streamUrl").value = "";
    });

    document.getElementById("copyBtn").addEventListener("click", () => {
      jsonOutput.select();
      navigator.clipboard.writeText(jsonOutput.value);
      alert("JSON copied! Ebar data.json file-e paste kore commit korun.");
    });
  </script>
</body>
</html>
